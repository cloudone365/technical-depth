# {{ ansible_managed }}
# kubeadm config for the root cluster (Step 19; explained line by line in
# 02-Kubernetes Step 01). kubeadm reads this once at 'kubeadm init'.
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ kubeadm_cluster_node_ip }}
  bindPort: 6443
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: unix:///run/containerd/containerd.sock
  # Empty list = no node-role.kubernetes.io/control-plane:NoSchedule taint.
  # dgx-spark-1 runs the control plane AND all workloads.
  taints: []
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ kubeadm_cluster_node_ip }}"
    - name: node-labels
      value: "{{ kubeadm_cluster_node_labels | join(',') }}"
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ kubeadm_cluster_name }}
kubernetesVersion: v{{ kubeadm_cluster_version }}
# A stable endpoint lets dgx-spark-2 (or a second control plane later) join.
controlPlaneEndpoint: "{{ kubeadm_cluster_api_endpoint }}"
networking:
  podSubnet: {{ kubeadm_cluster_pod_cidr }}
  serviceSubnet: {{ kubeadm_cluster_service_cidr }}
  dnsDomain: {{ kubeadm_cluster_dns_domain }}
apiServer:
  certSANs:
{% for san in kubeadm_cluster_cert_sans %}
    - "{{ san }}"
{% endfor %}
  extraArgs:
    - name: audit-policy-file
      value: {{ kubeadm_cluster_audit_dir }}/audit-policy.yaml
    - name: audit-log-path
      value: {{ kubeadm_cluster_audit_log_dir }}/audit.log
    - name: audit-log-maxage
      value: "7"
    - name: audit-log-maxbackup
      value: "5"
    - name: audit-log-maxsize
      value: "100"
    - name: encryption-provider-config
      value: {{ kubeadm_cluster_encryption_dir }}/config.yaml
  extraVolumes:
    - name: audit-policy
      hostPath: {{ kubeadm_cluster_audit_dir }}
      mountPath: {{ kubeadm_cluster_audit_dir }}
      readOnly: true
      pathType: Directory
    - name: audit-log
      hostPath: {{ kubeadm_cluster_audit_log_dir }}
      mountPath: {{ kubeadm_cluster_audit_log_dir }}
      pathType: DirectoryOrCreate
    - name: encryption
      hostPath: {{ kubeadm_cluster_encryption_dir }}
      mountPath: {{ kubeadm_cluster_encryption_dir }}
      readOnly: true
      pathType: Directory
controllerManager:
  extraArgs:
    - name: bind-address          # let Prometheus scrape :10257 from the pod network
      value: 0.0.0.0
scheduler:
  extraArgs:
    - name: bind-address          # :10259
      value: 0.0.0.0
etcd:
  local:
    dataDir: /var/lib/etcd
    extraArgs:
      - name: listen-metrics-urls # plain-HTTP metrics on :2381 for kube-prometheus-stack
        value: http://0.0.0.0:2381
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
maxPods: {{ kubeadm_cluster_max_pods }}
systemReserved:
{% for k, v in kubeadm_cluster_system_reserved.items() %}
  {{ k }}: "{{ v }}"
{% endfor %}
kubeReserved:
{% for k, v in kubeadm_cluster_kube_reserved.items() %}
  {{ k }}: "{{ v }}"
{% endfor %}
# Setting evictionHard replaces the defaults, so every signal is listed.
evictionHard:
{% for k, v in kubeadm_cluster_eviction_hard.items() %}
  {{ k }}: "{{ v }}"
{% endfor %}
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
# iptables mode on purpose: 02-Kubernetes Step 09 reads the KUBE-SVC/KUBE-SEP chains.
# Cilium runs as the CNI only (kubeProxyReplacement=false).
mode: iptables
metricsBindAddress: 0.0.0.0:10249
conntrack:
  maxPerCore: 65536
