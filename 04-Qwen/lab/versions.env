# 04-Qwen lab — pinned versions. Platform versions (Kubernetes, Kueue, KEDA,
# Traefik, GPU Operator …) come from 02-Kubernetes/lab/versions.env; the
# application stack (Open WebUI, LiteLLM, Qdrant, BGE-M3) is 03-DeepSeek's.
# NGC images are arm64 builds for DGX Spark (sm_121). Re-check the release notes
# before a fresh build:
#   https://docs.nvidia.com/deeplearning/frameworks/vllm-release-notes/
#   https://docs.nvidia.com/deeplearning/frameworks/pytorch-release-notes/
#
# The 02 base Deployment pins vllm:25.09-py3 (vLLM 0.10.1.1). That is too old
# for Qwen3-VL (vLLM >= 0.11) and Qwen3.5/3.6 (vLLM >= 0.17), so every 04
# overlay patches the image to this newer tag (scripts/gen_overlays.py).
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.08-py3
# ms-swift runs on the NGC PyTorch image; the pip pins stay inside the ranges
# ms-swift 4.5.3 declares (transformers<5.17, trl<1.0, peft<0.21, datasets<4.8.5).
PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:26.08-py3
PIP_SWIFT="ms-swift==4.5.3 transformers==5.16.1 trl==0.29.1 peft==0.20.0 datasets==4.8.4 accelerate==1.15.0"
PIP_GRPO="math-verify==0.9.0"
# Optional, for the Qwen-Agent comparison in tools/qwen_agent_demo.py (not needed by the lab)
PIP_QWEN_AGENT="qwen-agent==0.0.34"
# Smallest catalog model: dev-llms sandbox and smoke tests
SMOKE_MODEL=Qwen/Qwen3-0.6B
