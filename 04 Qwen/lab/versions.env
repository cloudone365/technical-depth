# 04 Qwen lab — pinned versions. Platform versions: "02 Kubernetes/lab/versions.env".
# Serving images, LiteLLM, Qdrant … are shared with "03 DeepSeek/lab/versions.env".
VLLM_IMAGE=nvcr.io/nvidia/vllm:25.09-py3
PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:25.09-py3
# ms-swift 3.8.x requires trl<0.21 and datasets<4.0 — a different set from 03's TRL pins
PIP_SWIFT="ms-swift==3.8.3 trl==0.20.0 transformers==4.56.2 peft==0.17.1 accelerate==1.10.1 datasets==3.6.0"
# llm-compressor 0.8.1 matches transformers 4.56.2 / datasets 4.1.1; install with --no-deps on NGC (it declares torch<=2.8)
PIP_LLMCOMPRESSOR="llmcompressor==0.8.1 compressed-tensors==0.12.2"
PIP_QWEN_AGENT="qwen-agent[code_interpreter]==0.0.29"
