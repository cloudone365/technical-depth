# Single source of truth for every version the 02-Kubernetes lab pins.
# Scripts `source` this file; docs quote it. Re-check before a fresh build:
#   Kubernetes:     https://kubernetes.io/releases/     (vCluster tests host 1.34–1.36)
#   vCluster:       https://www.vcluster.com/docs/vcluster/manage/upgrade/supported_versions
#   Cilium:         https://github.com/cilium/cilium/releases
#   GPU Operator:   helm search repo nvidia/gpu-operator -l
#   NGC images:     https://catalog.ngc.nvidia.com  (arm64 / "sbsa" tags for DGX Spark)
#
# Built by the 01-Ansible lab (keep these in step with its role defaults):
KUBERNETES_VERSION=v1.36.5            # kubeadm root cluster (roles/kubeadm_cluster)
CILIUM_VERSION=1.20.2                 # CNI (roles/cilium)
METALLB_CHART_VERSION=0.16.0          # LoadBalancer IPs 192.168.0.110–119 (roles/metallb)
GPU_OPERATOR_VERSION=v26.7.1          # 15 time-slices (roles/gpu_operator)
VCLUSTER_VERSION=0.37.1               # chart loft/vcluster + CLI; standard k8s distro (roles/vclusters)
# Installed by scripts/install-addons.sh:
LOCAL_PATH_VERSION=v0.0.31            # root: storage
METRICS_SERVER_CHART_VERSION=3.14.0   # root: kubectl top, HPAs (also proxied into both vClusters)
KPS_CHART_VERSION=70.4.2              # root: kube-prometheus-stack
ARGOCD_VERSION=v3.1.8                 # root: GitOps (Chapter 28)
GATEWAY_API_VERSION=v1.2.1            # llms: standard-install CRDs
TRAEFIK_CHART_VERSION=34.4.1          # llms: Traefik v3.3 — Ingress + Gateway API
KUEUE_VERSION=v0.13.4                 # llms: batch admission
KEDA_VERSION=v2.17.2                  # llms: event-driven autoscaling
CERT_MANAGER_VERSION=v1.17.1          # llms: needed by KServe
KSERVE_VERSION=v0.15.2                # llms: RawDeployment mode
# Images and tools:
NETSHOOT_IMAGE=nicolaka/netshoot:v0.13
CUDA_SAMPLE_IMAGE=nvcr.io/nvidia/cuda:13.0.1-base-ubuntu24.04
PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:25.09-py3
VLLM_IMAGE=nvcr.io/nvidia/vllm:25.09-py3
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:25.09-pyt-python-py3
SGLANG_IMAGE=lmsysorg/sglang:spark
FIO_IMAGE=docker.io/xridge/fio:3.38
PYTHON_IMAGE=python:3.12-slim
QDRANT_IMAGE=qdrant/qdrant:v1.13.4
SMOKE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
YQ_VERSION=v4.47.1                    # mikefarah yq (not the python 'yq' wrapper)
