# {{ ansible_managed }}
name: spark-monitoring
services:
  prometheus:
    image: {{ gpu_telemetry_prometheus_image }}
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.retention.time={{ gpu_telemetry_retention }}
      - --web.enable-lifecycle
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - prom-data:/prometheus
    network_mode: host          # scrape localhost exporters without NAT
    restart: unless-stopped
  alertmanager:
    image: {{ gpu_telemetry_alertmanager_image }}
    command: [--config.file=/etc/alertmanager/alertmanager.yml]
    volumes:
      - ./alertmanager:/etc/alertmanager:ro
    network_mode: host
    restart: unless-stopped
  grafana:
    image: {{ gpu_telemetry_grafana_image }}
    environment:
      GF_SECURITY_ADMIN_PASSWORD: "{{ gpu_telemetry_grafana_admin_password }}"
      GF_SERVER_HTTP_PORT: "3000"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana
    network_mode: host
    restart: unless-stopped
volumes:
  prom-data: {}
  grafana-data: {}
