{
 "title": "Spark \u00b7 Kubernetes",
 "uid": "spark-k8s",
 "tags": [
  "dgx-spark",
  "kubernetes"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Unified memory & GB10 (host exporters)",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false,
   "id": 1
  },
  {
   "type": "stat",
   "title": "UMA available",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "min(spark_uma_available_bytes) / 2^30",
     "refId": "A"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "decgbytes",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#cf222e",
        "value": null
       },
       {
        "color": "#bf8700",
        "value": 12
       },
       {
        "color": "#76b900",
        "value": 24
       }
      ]
     }
    }
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "GPU temp",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "max(spark_gpu_temperature_celsius)",
     "refId": "A"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#76b900",
        "value": null
       },
       {
        "color": "#bf8700",
        "value": 80
       },
       {
        "color": "#cf222e",
        "value": 90
       }
      ]
     }
    }
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "GPU power",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "max(spark_gpu_power_watts)",
     "refId": "A"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#76b900",
        "value": null
       }
      ]
     }
    }
   },
   "id": 4
  },
  {
   "type": "stat",
   "title": "Xid (24h)",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "max(spark_gpu_xid_events_24h)",
     "refId": "A"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#76b900",
        "value": null
       },
       {
        "color": "#cf222e",
        "value": 1
       }
      ]
     }
    }
   },
   "id": 5
  },
  {
   "type": "stat",
   "title": "GPU slices in use",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum(kube_pod_container_resource_requests{resource=\"nvidia_com_gpu\"} * on(namespace,pod) group_left() (kube_pod_status_phase{phase=\"Running\"}==1))",
     "refId": "A"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#76b900",
        "value": null
       }
      ]
     }
    }
   },
   "id": 6
  },
  {
   "type": "stat",
   "title": "Pending GPU pods",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum(kube_pod_status_phase{phase=\"Pending\"} * on(namespace,pod) group_left() (kube_pod_container_resource_requests{resource=\"nvidia_com_gpu\"}>0)) or vector(0)",
     "refId": "A"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#76b900",
        "value": null
       },
       {
        "color": "#bf8700",
        "value": 1
       }
      ]
     }
    }
   },
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "UMA: available vs page cache",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "spark_uma_available_bytes",
     "legendFormat": "available {{node}}",
     "refId": "A"
    },
    {
     "expr": "spark_uma_page_cache_bytes",
     "legendFormat": "page cache {{node}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "GPU utilisation",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "spark_gpu_utilization_ratio",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "#76b900"
     }
    },
    "overrides": []
   },
   "id": 9
  },
  {
   "type": "timeseries",
   "title": "SM clock / throttle",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "spark_gpu_sm_clock_mhz",
     "legendFormat": "SM MHz {{node}}",
     "refId": "A"
    },
    {
     "expr": "spark_gpu_throttle_reasons_bitmask",
     "legendFormat": "throttle bitmask",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "id": 10
  },
  {
   "type": "row",
   "title": "Tenancy",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 12
   },
   "collapsed": false,
   "id": 11
  },
  {
   "type": "timeseries",
   "title": "CPU used / hard by namespace",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "kube_resourcequota{type=\"used\",resource=\"requests.cpu\"}",
     "legendFormat": "used {{namespace}}",
     "refId": "A"
    },
    {
     "expr": "kube_resourcequota{type=\"hard\",resource=\"requests.cpu\"}",
     "legendFormat": "hard {{namespace}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "id": 12
  },
  {
   "type": "timeseries",
   "title": "Memory used / hard",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "kube_resourcequota{type=\"used\",resource=\"limits.memory\"}",
     "legendFormat": "used {{namespace}}",
     "refId": "A"
    },
    {
     "expr": "kube_resourcequota{type=\"hard\",resource=\"limits.memory\"}",
     "legendFormat": "hard {{namespace}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "id": 13
  },
  {
   "type": "timeseries",
   "title": "CPU throttling (top 5 containers)",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "topk(5, rate(container_cpu_cfs_throttled_periods_total{container!=\"\"}[5m]) / rate(container_cpu_cfs_periods_total{container!=\"\"}[5m]))",
     "legendFormat": "{{namespace}}/{{pod}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "#cf222e"
     }
    },
    "overrides": []
   },
   "id": 14
  },
  {
   "type": "row",
   "title": "Serving SLOs (vLLM)",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 20
   },
   "collapsed": false,
   "id": 15
  },
  {
   "type": "timeseries",
   "title": "TTFT p95",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 21
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "spark:vllm_ttft_p95_seconds",
     "legendFormat": "{{namespace}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#76b900",
        "value": null
       },
       {
        "color": "#cf222e",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 16
  },
  {
   "type": "timeseries",
   "title": "Time per output token p95",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 21
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "spark:vllm_tpot_p95_seconds",
     "legendFormat": "{{namespace}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "id": 17
  },
  {
   "type": "timeseries",
   "title": "Queue & KV cache",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 21
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum(vllm:num_requests_running)",
     "legendFormat": "running",
     "refId": "A"
    },
    {
     "expr": "sum(vllm:num_requests_waiting)",
     "legendFormat": "waiting",
     "refId": "B"
    },
    {
     "expr": "max(vllm:gpu_cache_usage_perc)*100",
     "legendFormat": "KV cache %",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "id": 18
  },
  {
   "type": "row",
   "title": "Control plane",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 28
   },
   "collapsed": false,
   "id": 19
  },
  {
   "type": "timeseries",
   "title": "etcd WAL fsync p99",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 29
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(etcd_disk_wal_fsync_duration_seconds_bucket[5m])))",
     "legendFormat": "p99",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "#1f6feb"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#76b900",
        "value": null
       },
       {
        "color": "#cf222e",
        "value": 0.05
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 20
  },
  {
   "type": "timeseries",
   "title": "API server p99 latency (mutating)",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 29
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le, verb) (rate(apiserver_request_duration_seconds_bucket{verb=~\"POST|PUT|PATCH|DELETE\"}[5m])))",
     "legendFormat": "{{verb}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "#1f6feb"
     }
    },
    "overrides": []
   },
   "id": 21
  },
  {
   "type": "timeseries",
   "title": "APF: rejected / queued",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 29
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum by (priority_level) (rate(apiserver_flowcontrol_rejected_requests_total[5m]))",
     "legendFormat": "rejected {{priority_level}}",
     "refId": "A"
    },
    {
     "expr": "sum by (priority_level) (apiserver_flowcontrol_current_inqueue_requests)",
     "legendFormat": "queued {{priority_level}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "id": 22
  }
 ]
}
