# 03-DeepSeek lab — pinned versions. Platform versions come from
# "02-Kubernetes/lab/versions.env" (kubeadm, Cilium, GPU Operator, Kueue, KEDA, Traefik, kps …).
# NGC images: arm64 builds with sm_121 support for DGX Spark. Re-check monthly.
VLLM_IMAGE=nvcr.io/nvidia/vllm:25.09-py3
VLLM_NEXT_IMAGE=nvcr.io/nvidia/vllm:26.01-py3   # step 3 candidate (Chapter 06 Task 5.8, k8s/upgrade/vllm-next); verify the arm64 manifest before use
PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:25.09-py3
SGLANG_IMAGE=lmsysorg/sglang:spark
TRTLLM_IMAGE=nvcr.io/nvidia/tensorrt-llm/release:1.1.0          # confirm the DGX Spark tag on NGC
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda           # or build from source for sm_121 (Chapter 07)
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.6.30
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.77.5-stable
QDRANT_IMAGE=qdrant/qdrant:v1.13.4-unprivileged
POSTGRES_IMAGE=postgres:16.10-alpine
VAULT_IMAGE=hashicorp/vault:1.20.4
LWS_VERSION=v0.7.0
# Python packages installed on top of the NGC PyTorch image (same era as 25.09)
PIP_TRL="trl==0.23.0 peft==0.17.1 transformers==4.56.2 accelerate==1.10.1 datasets==4.1.1"
PIP_EVAL="lm-eval==0.4.9.1"
